<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.WelcomeToolbar"
             x:DataType="vm:Welcome">
  <Grid ColumnDefinitions="Auto,*,Auto">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="icon_button toolbar_icon_button"
              Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Margin="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonMargin}" Padding="0"
              Command="{Binding Clone}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.Clone}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+R, macOS=⌘+R}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <Path Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Data="{StaticResource Icons.Clone}" Margin="0,4,0,0"/>
      </Button>

      <Button Classes="icon_button toolbar_icon_button"
              Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Margin="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonMargin}" Padding="0"
              Command="{Binding OpenLocalRepository}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+L, macOS=⌘+L}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <Path Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Data="{StaticResource Icons.Folder.Open}" Margin="0,2,0,0"/>
      </Button>

      <Button Classes="icon_button toolbar_icon_button"
              Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Margin="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonMargin}" Padding="0"
              Command="{Binding OpenTerminal}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+`, macOS=Λ+`}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <Path Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Data="{StaticResource Icons.Terminal}"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Classes="icon_button toolbar_icon_button"
              Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Margin="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonMargin}" Padding="0"
              Command="{Binding AddRootNode}" ToolTip.Tip="{DynamicResource Text.Welcome.AddRootFolder}">
        <Path Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Margin="0,2,0,0" Data="{StaticResource Icons.Folder.Add}"/>
      </Button>

      <Button Classes="icon_button toolbar_icon_button"
              Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonSize}"
              Margin="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconButtonMargin}" Padding="0"
              Command="{Binding ScanDefaultCloneDir}" ToolTip.Tip="{DynamicResource Text.Welcome.ScanDefaultCloneDir}">
        <Path Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=ToolbarIconSize}"
              Data="{StaticResource Icons.Scan}"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
